# =====================================================================
# Malibou Chocolate — Salin file ini menjadi ".env.local"
# lalu isi dengan nilai sebenarnya dari dashboard Supabase
# (Project Settings > API / Database).
# =====================================================================

# URL project Supabase (contoh: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Key publik (publishable/anon) — dipakai browser untuk membaca katalog.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXX"

# Key secret/service — dipakai dashboard admin (/admin) untuk CRUD katalog
# dan verifikasi login (tabel public.users). PERINGATAN: pada aplikasi
# static export key ini ikut tertanam di bundle browser. Ganti/rotasi key
# di dashboard Supabase bila diperlukan.
NEXT_PUBLIC_SUPABASE_SECRET_KEY="sb_secret_XXXX"

# Koneksi database untuk migration runner (scripts/migrate.mjs).
# Jangan pernah meletakkan ini di kode browser. Jika password mengandung
# karakter khusus, URL-encode dulu ( / -> %2F, + -> %2B, @ -> %40 ).
DATABASE_URL="postgresql://postgres:YOURPASSWORD@db.<ref>.supabase.co:5432/postgres"

# URL dasar situs produksi (tanpa slash di akhir).
# Dipakai agar URL gambar OpenGraph / Twitter resolution untuk berbagi
# media sosial menunjuk ke domain produksi, bukan localhost.
# Contoh: https://malibouchocolate.com
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ---------------------------------------------------------------------
# CATATAN LOGIN ADMIN (/admin)
#   Username/password diverifikasi ke tabel public.users (hash bcrypt),
#   bukan dari file ini. Kredensial default yang di-seed:
#       username : admin
#       password : malibou123
#   Bila Supabase belum dikonfigurasi, fallback memakai kredensial yang
#   sama (konstanta di src/lib/adminConfig.ts).
# ---------------------------------------------------------------------